rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       FUNCIONES DE AYUDA
    ========================== */

    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica rol sin causar recursividad ni usar if/let
    function hasRole(roleName) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == roleName;
    }

    function isSuperAdmin() { return hasRole('superAdmin'); }
    function isOwner() { return hasRole('owner'); }
    function isEmployee() { return hasRole('employee'); }

    function isShopOwner(shopId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/iceCreamShops/$(shopId)) &&
             get(/databases/$(database)/documents/iceCreamShops/$(shopId)).data.owner == request.auth.uid;
    }

    function hasPermission(shopId, permission) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/iceCreamShops/$(shopId)) &&
             get(/databases/$(database)/documents/iceCreamShops/$(shopId)).data.members[request.auth.uid].permissions[permission] == true;
    }

    function isSessionOwner(shopId, sessionId) {
      return isSignedIn() &&
             sessionId != null &&
             exists(/databases/$(database)/documents/iceCreamShops/$(shopId)/cashSessions/$(sessionId)) &&
             get(/databases/$(database)/documents/iceCreamShops/$(shopId)/cashSessions/$(sessionId)).data.employeeId == request.auth.uid;
    }

    /* =========================
       COLECCIONES GLOBALES
    ========================== */

    match /permissions/{permissionId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Regla combinada para evitar recursión y permitir listar
      allow read, update: if isSignedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() || 
        isOwner() || 
        isEmployee()
      );
      
      allow delete: if isSuperAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow get: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        isShopOwner(resource.data.shopId) ||
        hasPermission(resource.data.shopId, 'pos_access') ||
        isSuperAdmin()
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() || 
        isOwner() || 
        isEmployee() || 
        resource.data.clientId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isShopOwner(resource.data.shopId) ||
        hasPermission(resource.data.shopId, 'pos_access') ||
        isSuperAdmin()
      );
    }

    /* =========================
       TIENDAS
    ========================== */

    match /iceCreamShops/{shopId} {
      allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.owner == request.auth.uid ||
        (resource.data.members != null && resource.data.members[request.auth.uid] != null) ||
        isSuperAdmin()
      );
      allow update, delete: if isShopOwner(shopId) || isSuperAdmin();

      match /roles/{roleId} { allow read, write: if isShopOwner(shopId) || isSuperAdmin(); }
      
      match /invitations/{invitationId} {
        allow get: if true;
        allow list, create, delete: if isShopOwner(shopId);
        allow update: if isSignedIn() && request.auth.token.email == resource.data.email && resource.data.status == 'pending';
      }

      match /ingredientes/{ingredienteId} {
        allow read: if isShopOwner(shopId) || hasPermission(shopId, 'ingredients_view') || hasPermission(shopId, 'pos_access') || hasPermission(shopId, 'purchases_create') || isSuperAdmin();
        allow create: if isShopOwner(shopId) || hasPermission(shopId, 'ingredients_create');
        allow update: if isShopOwner(shopId) || hasPermission(shopId, 'ingredients_update') || hasPermission(shopId, 'purchases_create');
        allow delete: if isShopOwner(shopId) || hasPermission(shopId, 'ingredients_delete');
      }
      
      match /inventoryAdjustments/{adjustmentId} {
        allow create: if isShopOwner(shopId) || hasPermission(shopId, 'ingredients_adjust_stock') || isSuperAdmin();
        allow read: if isShopOwner(shopId) || hasPermission(shopId, 'reports_view_inventory') || isSuperAdmin();
      }
      
      match /productos/{productoId} {
        allow read: if true;
        allow write: if isShopOwner(shopId) || hasPermission(shopId, 'products_create') || hasPermission(shopId, 'products_update') || hasPermission(shopId, 'products_delete') || isSuperAdmin();
      }
      
      match /compras/{compraId} {
        allow read: if isShopOwner(shopId) || hasPermission(shopId, 'products_view') || hasPermission(shopId, 'pos_access') || isSuperAdmin();
        allow write: if isShopOwner(shopId) || hasPermission(shopId, 'purchases_create') || hasPermission(shopId, 'purchases_update') || hasPermission(shopId, 'purchases_delete') || isSuperAdmin();
      }
      
      match /suppliers/{supplierId} {
        allow read: if isShopOwner(shopId) || hasPermission(shopId, 'suppliers_view') || hasPermission(shopId, 'purchases_create') || isSuperAdmin();
        allow write: if isShopOwner(shopId) || hasPermission(shopId, 'suppliers_create') || hasPermission(shopId, 'suppliers_update') || hasPermission(shopId, 'suppliers_delete') || hasPermission(shopId, 'purchases_create') || isSuperAdmin();
      }
      
      match /sales/{saleId} {
        allow create: if isShopOwner(shopId) || (hasPermission(shopId, 'pos_access') && request.resource.data.sessionId != null && isSessionOwner(shopId, request.resource.data.sessionId));
        allow read, list: if isShopOwner(shopId) || hasPermission(shopId, 'reports_view_sales') || hasPermission(shopId, 'cash_session_access') || isSuperAdmin();
      }
      
      match /cashSessions/{cashSessionId} {
        allow read: if isShopOwner(shopId) || hasPermission(shopId, 'cash_session_access') || hasPermission(shopId, 'cash_session_view_history') || isSuperAdmin();
        allow create: if isShopOwner(shopId) || hasPermission(shopId, 'cash_session_open_close') || isSuperAdmin();
        allow update: if isShopOwner(shopId) || (hasPermission(shopId, 'cash_session_open_close') && isSessionOwner(shopId, cashSessionId)) || isSuperAdmin();
      }
      
      match /expenses/{expenseId} {
        allow read: if isShopOwner(shopId) || hasPermission(shopId, 'expenses_view') || hasPermission(shopId, 'pos_access') || isSuperAdmin();
        allow create: if isShopOwner(shopId) || hasPermission(shopId, 'expenses_create') || hasPermission(shopId, 'pos_access') || isSuperAdmin();
        allow update: if isShopOwner(shopId) || hasPermission(shopId, 'expenses_update') || isSuperAdmin();
        allow delete: if isShopOwner(shopId) || hasPermission(shopId, 'expenses_delete') || isSuperAdmin();
      }
      
      match /promotions/{promotionId} {
        allow read: if isShopOwner(shopId) || hasPermission(shopId, 'promotions_view') || hasPermission(shopId, 'pos_access') || isSuperAdmin();
        allow write: if isShopOwner(shopId) || hasPermission(shopId, 'promotions_create') || hasPermission(shopId, 'promotions_update') || hasPermission(shopId, 'promotions_delete') || isSuperAdmin();
      }
      
      match /paymentMethods/{paymentMethodId} {
        allow read: if isShopOwner(shopId) || hasPermission(shopId, 'pos_access') || isSuperAdmin();
        allow write: if isShopOwner(shopId) || isSuperAdmin();
      }
    }
  }
}
